@startuml
title Validación de resultados por bioquímico
start
repeat
  partition "Bioquímico" {
    :Consultar resultados\npendientes de validación;
    if (¿Existen resultados\nsin validar?) then (No)
      :Mostrar "sin resultados\npendientes";
      stop
    else (Sí)
      :Selecciona un resultado;
    endif
    :Revisa valor vs rangos\nde referencia;
    if (¿Valor supera umbral\ncrítico?) then (Sí)
      :Confirmar criticalidad\ny generar alerta;
      note right
        Regla de negocio: un valor
        crítico no puede rechazarse
        directamente; requiere
        escalamiento.
      end note
    elseif (¿Valor fuera de rango)? then (Sí)
      :Marca flag is_anormal;
    endif
    if (¿Se aprueba el\nresultado?) then (Sí)
    else (No / Rechazo)
      :Solicitar motivo\ndel rechazo;
      if (¿Motivo\nproporcionado?) then (Sí)
      else (No)
        :Excepción: motivo\nobligatorio;
        stop
      endif
    endif
  }

  partition "Sistema" {
    if (¿Se aprueba?) then (Sí)
      :Registrar validación\n(validated_by, validated_at);
      :Actualizar item a\nresultado_listo;
      :Disponible en EMR\npara el médico;
    else (motivo válido)
      :Registrar rechazo\ny notify al técnico;
    endif
  }

  partition "Técnico de Laboratorio" {
    if (¿Hubo rechazo?) then (Sí)
      :Corrige el resultado;
      :Volver a pendiente;
    endif
  }
repeat while (¿Hay más resultados pendientes?) is (Sí)
-> No;
stop
@enduml